{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Wrapped",
  "version": "1.4.0",
  "identifier": "io.github.aiwrapped.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 年度报告",
        "width": 1200,
        "height": 790,
        "minWidth": 860,
        "minHeight": 566,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#07040F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AI Wrapped",
    "shortDescription": "AI 年度报告",
    "longDescription": "读取本机各个 AI agent 的聊天记录，生成一份年度回顾。所有数据只在本机读取。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
